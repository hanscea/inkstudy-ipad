# Publish the current native project only. Local research and web prototypes stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/collaboration/
!/native/
/native/*
!/native/InkStudy/

# Dependencies and generated files.
node_modules/
dist/
coverage/
.build/
.swiftpm/
build/
DerivedData/
__pycache__/
*.pyc
.DS_Store
*.log
*.xcresult/
xcuserdata/
*.xcuserstate
*.app/
*.ipa
*.dSYM/
*.xcarchive/
*.zip
*.tar.gz

# Credentials, signing material, pairing state and local exports.
.env
.env.*
!.env.example
*.key
*.pem
*.p8
*.p12
*.mobileprovision
*API*Key*.md
APIK.md
.hint-runtime/
runtime/
test-output/
HintPreviewBootstrap.json
*.sqlite
*.sqlite-*
*.db
*.db-*

# Historical delivery reports remain on the author's machine.
/native/InkStudy/RELEASE_*.md
/native/InkStudy/TESTING_STATUS.md
